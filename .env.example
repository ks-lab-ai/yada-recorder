# Uniquement pour `make dev`. L'app installée lit ses clés dans le Trousseau macOS
# (Réglages de la fenêtre Transcripts), jamais dans ce fichier.
# Copier en .env à la racine. Une valeur du Trousseau est prioritaire sur .env.

SUPABASE_URL=https://<ton-projet>.supabase.co
# Dashboard Supabase > Project Settings > API Keys > Secret key (sb_secret_…) ou service_role
SUPABASE_SECRET_KEY=

# deepgram (recommandé) ou elevenlabs
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Résumé + next steps (claude-sonnet-5-5)
ANTHROPIC_API_KEY=

# Port local de l'app (doit correspondre au réglage de l'extension, 47311 par défaut)
# YADAREC_PORT=47311
